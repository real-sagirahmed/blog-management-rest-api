{
  "info": {
    "_postman_id": "9f3d8a22-6e11-4d7c-b34a-91d2e8c04f10",
    "name": "Blog Management REST API (V1.0)",
    "description": "End-to-end Postman test suite covering Categories and Posts CRUD, PATCH partial updates, Search/Filter/Sort/Pagination, and RFC 9110 ProblemDetails error contracts (TC-01..TC-17).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Categories",
      "item": [
        {
          "name": "Create Category (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueName = 'Postman Category ' + Date.now();",
                  "pm.environment.set('tempCategoryName', uniqueName);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Category response contains expected fields', function () {",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json.name).to.eql(pm.environment.get('tempCategoryName'));",
                  "});",
                  "pm.environment.set('categoryId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{tempCategoryName}}\",\n  \"description\": \"Created during automated Postman verification.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [ "{{baseUrl}}" ],
              "path": [ "categories" ]
            }
          }
        },
        {
          "name": "TC-17 Create Duplicate Category Name (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('ProblemDetails reports Conflict', function () {",
                  "    pm.expect(json.status).to.eql(409);",
                  "    pm.expect(json.title).to.eql('Conflict');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{tempCategoryName}}\",\n  \"description\": \"Duplicate attempt.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [ "{{baseUrl}}" ],
              "path": [ "categories" ]
            }
          }
        },
        {
          "name": "Get All Categories (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [ "{{baseUrl}}" ],
              "path": [ "categories" ]
            }
          }
        },
        {
          "name": "Get Category By ID (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returned ID matches environment variable', function () {",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get('categoryId')));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "categories", "{{categoryId}}" ]
            }
          }
        },
        {
          "name": "Update Category (204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{tempCategoryName}}\",\n  \"description\": \"Updated category description.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "categories", "{{categoryId}}" ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Posts CRUD & Querying",
      "item": [
        {
          "name": "TC-04 Create Valid Post (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Server generated unique slug', function () {",
                  "    pm.expect(json.slug).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.updatedAt).to.be.null;",
                  "});",
                  "pm.environment.set('postId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman ASP.NET Core Guide\",\n  \"excerpt\": \"An introduction to ASP.NET Core Web API.\",\n  \"content\": \"ASP.NET Core is a modern framework for building RESTful web APIs and services.\",\n  \"categoryId\": {{categoryId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [ "{{baseUrl}}" ],
              "path": [ "posts" ]
            }
          }
        },
        {
          "name": "TC-07 Create Duplicate Title Auto-Suffixed Slug (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Slug received numeric suffix', function () {",
                  "    pm.expect(json.slug).to.match(/-\\d+$/);",
                  "});",
                  "pm.environment.set('secondPostId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman ASP.NET Core Guide\",\n  \"excerpt\": \"Second post sharing the same title.\",\n  \"content\": \"Verifying automatic server-side slug deduplication behavior.\",\n  \"categoryId\": {{categoryId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [ "{{baseUrl}}" ],
              "path": [ "posts" ]
            }
