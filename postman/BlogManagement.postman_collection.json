          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Invalid Category Test\",\n  \"content\": \"Content that is long enough to pass min length.\",\n  \"categoryId\": 999999\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [ "{{baseUrl}}" ],
              "path": [ "posts" ]
            }
          }
