        {
          "name": "TC-01 / TC-13..15 Search, Filter, Sort & Paginate Posts (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Paginated response structure is valid without content field', function () {",
                  "    pm.expect(json).to.have.all.keys('items', 'pageNumber', 'pageSize', 'totalCount', 'totalPages');",
                  "    pm.expect(json.totalCount).to.be.at.least(2);",
                  "    pm.expect(json.items[0]).to.not.have.property('content');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts?search=asp.net&categoryId={{categoryId}}&pageNumber=1&pageSize=10&sortBy=createdAt&sortOrder=desc",
              "host": [ "{{baseUrl}}" ],
              "path": [ "posts" ],
              "query": [
                { "key": "search", "value": "asp.net" },
                { "key": "categoryId", "value": "{{categoryId}}" },
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          }
        },
