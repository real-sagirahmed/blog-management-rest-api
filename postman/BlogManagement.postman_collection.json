        {
          "name": "TC-05 Create Post Missing Title (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('ProblemDetails contains Title validation error', function () {",
                  "    pm.expect(json.title).to.eql('Validation Error');",
                  "    pm.expect(json.errors).to.have.property('Title');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"excerpt\": \"Missing title test\",\n  \"content\": \"Content that is long enough to pass min length.\",\n  \"categoryId\": {{categoryId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [ "{{baseUrl}}" ],
              "path": [ "posts" ]
            }
          }
        },
        {
          "name": "TC-06 Create Post Invalid CategoryId (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
